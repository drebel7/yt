{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio Remote (mini2)",
      "options": {
        "baseURL": "http://mini2:1234/v1",
        "timeout": 3600000,      // 60 minutes (in ms)
        "chunkTimeout": 3000000,    // 50 minutes (in ms)
		"setCacheKey": true
      },
      "models": {
        "qwen/qwen3.6-35b-a3b": {
          "name": "qwen/qwen3.6-35b-a3b",
          "capabilities": ["text_generation", "code_analysis", "tool_use"]
        },
        "ornith-ai/Ornith-1.5-35B-A3B-GGUF": {
          "name": "ornith-ai/Ornith-1.5-35B-A3B-GGUF",
          "capabilities": ["text_generation", "code_analysis", "tool_use"]
        },
        "deepseek-coder-v2-lite-instruct": {
          "name": "deepseek-coder-v2-lite-instruct"
        },
        "nvidia/nemotron-3-annotated-omni": {
          "name": "nvidia/nemotron-3-nano-omni"
        },
        "google/gemma-4-26b-a4b": {
          "name": "google/gemma-4-26b-a4b"
        }
      }
    }
  },
  "mcp": {
	"youtube": {
		"type": "local",
		"command": [
			"C:\\daniel\\_workspace\\github\\Youtube_transcripts\\youtube-mcp\\.venv\\Scripts\\python.exe",
			"C:\\daniel\\_workspace\\github\\Youtube_transcripts\\youtube-mcp\\youtube_server.py"
		],
		"enabled": true,
		"environment": {
			"YOUTUBE_API_KEY": "{env:YOUTUBE_API_KEY}"
		}
	}
  },
  "model": "opencode/deepseek-v4.1-flash"
}